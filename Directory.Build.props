<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Directory.Build.props - Centralized build properties for StockSharp
    This file is automatically imported by all .csproj files in subdirectories.
    It provides common security hardening, code analysis, and build settings.
  -->

  <PropertyGroup>
    <!-- Security: Enable security mitigations -->
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    
    <!-- Security: Treat warnings as errors in Release builds -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    
    <!-- Security: High warning level -->
    <WarningLevel>4</WarningLevel>
    
    <!-- Code Analysis: Enable all rules -->
    <RunCodeAnalysis>true</RunCodeAnalysis>
    <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)AllRules.ruleset</CodeAnalysisRuleSet>
    
    <!-- Deterministic builds for reproducibility -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    
    <!-- Assembly signing (if key file exists) -->
    <SignAssembly Condition="Exists('$(MSBuildThisFileDirectory)Ecng.pfx')">true</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="Exists('$(MSBuildThisFileDirectory)Ecng.pfx')">$(MSBuildThisFileDirectory)Ecng.pfx</AssemblyOriginatorKeyFile>
    
    <!-- Documentation generation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(AssemblyName).xml</DocumentationFile>
    
    <!-- Debug symbols for Release (portable PDB) -->
    <DebugType Condition="'$(Configuration)' == 'Release'">portable</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">true</DebugSymbols>
    
    <!-- High entropy ASLR support -->
    <HighEntropyVA>true</HighEntropyVA>
    
    <!-- Control Flow Guard (requires Windows 8.1+/VS 2015+) -->
    <ControlFlowGuard Condition="'$(TargetFrameworkVersion)' != 'v4.0'">true</ControlFlowGuard>
    
    <!-- Common assembly attributes -->
    <CompanyName>PreCog Security</CompanyName>
    <ProductName>StockSharp Trading Platform</ProductName>
    <Copyright>Copyright © PreCog Security 2024</Copyright>
    <Trademark></Trademark>
    <AssemblyVersion>4.3.12.0</AssemblyVersion>
    <FileVersion>4.3.12.0</FileVersion>
    <InformationalVersion>4.3.12.0</InformationalVersion>
    
    <!-- Neutral language for localization -->
    <NeutralLanguage>en-US</NeutralLanguage>
    
    <!-- Suppress specific legacy warnings that are noise in this codebase -->
    <NoWarn>$(NoWarn);1591;1573;1572;1570;1587;1584;1712;1711;1710;1709;1708;1707;1706;1705;1704;1703;1702;1701;1700;1699;1698;1697;1696;1695;1694;1693;1692;1691;1690;1689;1688;1687;1686;1685;1684;1683;1682;1681;1680;1679;1678;1677;1676;1675;1674;1673;1672;1671;1670;1669;1668;1667;1666;1665;1664;1663;1662;1661;1660;1659;1658;1657;1656;1655;1654;1653;1652;1651;1650;1649;1648;1647;1646;1645;1644;1643;1642;1641;1640;1639;1638;1637;1637;1636;1635;1634;1633;1632;1631;1630;1629;1628;1627;1626;1625;1624;1623;1622;1621;1620;1619;1618;1617;1616;1615;1614;1613;1612;1611;1610;1609;1608;1607;1606;1605;1604;1603;1602;1601;1600</NoWarn>
  </PropertyGroup>

  <!-- Security: Additional compiler options for hardening -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Enable buffer security checks (/GS) - default on but explicit -->
    <BufferSecurityCheck>true</BufferSecurityCheck>
    
    <!-- Enable stack protection -->
    <EnableEnhancedInstructionSet>SSE2</EnableEnhancedInstructionSet>
  </PropertyGroup>

  <!-- Import common assembly info -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)StockSharpAssemblyInfo.cs" Condition="Exists('$(MSBuildThisFileDirectory)StockSharpAssemblyInfo.cs')">
      <Link>Properties\StockSharpAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>

  <!-- Reference common Ecng libraries from References folder -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)References\Ecng')">
    <Reference Include="Ecng.Collections">
      <HintPath>$(MSBuildThisFileDirectory)References\Ecng\Ecng.Collections.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Ecng.Common">
      <HintPath>$(MSBuildThisFileDirectory)References\Ecng\Ecng.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Ecng.ComponentModel">
      <HintPath>$(MSBuildThisFileDirectory)References\Ecng\Ecng.ComponentModel.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Ecng.Configuration">
      <HintPath>$(MSBuildThisFileDirectory)References\Ecng\Ecng.Configuration.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Ecng.Data">
      <HintPath>$(MSBuildThisFileDirectory)References\Ecng\Ecng.Data.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Ecng.Interop">
      <HintPath>$(MSBuildThisFileDirectory)References\Ecng\Ecng.Interop.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Ecng.Net">
      <HintPath>$(MSBuildThisFileDirectory)References\Ecng\Ecng.Net.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Ecng.Reflection">
      <HintPath>$(MSBuildThisFileDirectory)References\Ecng\Ecng.Reflection.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Ecng.Serialization">
      <HintPath>$(MSBuildThisFileDirectory)References\Ecng\Ecng.Serialization.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Ecng.Serialization.FieldFactories">
      <HintPath>$(MSBuildThisFileDirectory)References\Ecng\Ecng.Serialization.FieldFactories.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Ecng.Localization">
      <HintPath>$(MSBuildThisFileDirectory)References\Ecng\Ecng.Localization.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Ecng.Web">
      <HintPath>$(MSBuildThisFileDirectory)References\Ecng\Ecng.Web.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Ecng.Xaml">
      <HintPath>$(MSBuildThisFileDirectory)References\Ecng\Ecng.Xaml.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MoreLinq">
      <HintPath>$(MSBuildThisFileDirectory)References\Ecng\MoreLinq.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Xceed.Wpf.Toolkit">
      <HintPath>$(MSBuildThisFileDirectory)References\Ecng\Xceed.Wpf.Toolkit.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Common project references (exclude self-references to avoid circular dependencies) -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)Localization\Localization.csproj" Condition="Exists('$(MSBuildThisFileDirectory)Localization\Localization.csproj') And '$(MSBuildProjectName)' != 'Localization'" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Logging\Logging.csproj" Condition="Exists('$(MSBuildThisFileDirectory)Logging\Logging.csproj') And '$(MSBuildProjectName)' != 'Logging'" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Messages\Messages.csproj" Condition="Exists('$(MSBuildThisFileDirectory)Messages\Messages.csproj') And '$(MSBuildProjectName)' != 'Messages'" />
  </ItemGroup>

</Project>