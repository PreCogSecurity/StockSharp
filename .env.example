# StockSharp Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control!

# =============================================================================
# QUICK (QUIK) CONNECTOR SETTINGS
# =============================================================================
# QUIK trading terminal connection credentials
# These are used by the Anywhere sample application and Quik connector
QUIK_LOGIN=your_quik_login
QUIK_PASSWORD=your_quik_password

# QUIK Lua connection address (default: localhost:5001)
# QUIK_LUA_ADDRESS=localhost:5001

# QUIK DDE service name (default: QUIK)
# QUIK_DDE_SERVICE=QUIK

# =============================================================================
# INTERACTIVE BROKERS SETTINGS
# =============================================================================
# IB Gateway/TWS connection
# IB_HOST=127.0.0.1
# IB_PORT=4001
# IB_CLIENT_ID=1
# IB_ACCOUNT=your_account_id

# =============================================================================
# FIX/FAST CONNECTOR SETTINGS
# =============================================================================
# FIX connection settings
# FIX_SENDER_COMP_ID=your_sender_comp_id
# FIX_TARGET_COMP_ID=your_target_comp_id
# FIX_USERNAME=your_username
# FIX_PASSWORD=your_password
# FIX_HOST=fix.example.com
# FIX_PORT=9878
# FIX_VERSION=FIX.4.4
# FIX_HEARTBEAT_INTERVAL=30
# FIX_RESET_ON_LOGON=Y
# FIX_RESET_ON_LOGOUT=Y
# FIX_RESET_ON_DISCONNECT=Y

# =============================================================================
# LMAX SETTINGS
# =============================================================================
# LMAX_USERNAME=your_username
# LMAX_PASSWORD=your_password
# LMAX_URL=https://web-order.lmax.com
# LMAX_ACCOUNT_ID=your_account_id

# =============================================================================
# RITHMIC SETTINGS
# =============================================================================
# RITHMIC_USERNAME=your_username
# RITHMIC_PASSWORD=your_password
# RITHMIC_SYSTEM_NAME=Rithmic
# RITHMIC_FRONT_END=your_front_end

# =============================================================================
# CRYPTO EXCHANGE SETTINGS
# =============================================================================
# BitStamp
# BITSTAMP_API_KEY=your_api_key
# BITSTAMP_API_SECRET=your_api_secret
# BITSTAMP_CLIENT_ID=your_client_id

# Binance
# BINANCE_API_KEY=your_api_key
# BINANCE_API_SECRET=your_api_secret

# Coinbase Pro
# COINBASE_API_KEY=your_api_key
# COINBASE_API_SECRET=your_api_secret
# COINBASE_PASSPHRASE=your_passphrase

# =============================================================================
# DATA FEED SETTINGS
# =============================================================================
# IQFeed
# IQFEED_USERNAME=your_username
# IQFEED_PASSWORD=your_password
# IQFEED_PRODUCT_ID=your_product_id
# IQFEED_VERSION=your_version

# CQG
# CQG_USERNAME=your_username
# CQG_PASSWORD=your_password

# =============================================================================
# DATABASE SETTINGS (for Hydra data storage)
# =============================================================================
# SQL Server
# DB_CONNECTION_STRING=Server=localhost;Database=StockSharp;Trusted_Connection=True;
# DB_PROVIDER=System.Data.SqlClient

# SQLite (for development)
# DB_CONNECTION_STRING=Data Source=StockSharp.db
# DB_PROVIDER=System.Data.SQLite

# PostgreSQL
# DB_CONNECTION_STRING=Host=localhost;Database=StockSharp;Username=postgres;Password=your_password
# DB_PROVIDER=Npgsql

# =============================================================================
# CLOUD STORAGE SETTINGS (for backup)
# =============================================================================
# AWS S3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your_bucket_name

# Azure Blob Storage
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
# AZURE_CONTAINER_NAME=your_container

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
# Log level: Debug, Info, Warn, Error, Fatal
# LOG_LEVEL=Info

# Log file path (relative to application directory)
# LOG_FILE_PATH=logs\stocksharp.log

# Enable console logging
# LOG_CONSOLE=true

# =============================================================================
# LICENSE SETTINGS
# =============================================================================
# License key for commercial features
# LICENSE_KEY=your_license_key

# =============================================================================
# PROXY SETTINGS
# =============================================================================
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.local

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Maximum degree of parallelism for data processing
# MAX_DEGREE_OF_PARALLELISM=4

# Market data buffer size
# MARKET_DATA_BUFFER_SIZE=10000

# =============================================================================
# DEVELOPMENT/DEBUG SETTINGS
# =============================================================================
# Enable detailed diagnostic logging
# DIAGNOSTICS_ENABLED=false

# Mock mode for testing without real connections
# MOCK_MODE=false

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. NEVER commit actual credentials to version control
# 2. Use strong, unique passwords for each service
# 3. Rotate credentials regularly
# 4. Use environment variables in production (Docker, Kubernetes, Azure, AWS)
# 5. Consider using secret managers: Azure Key Vault, AWS Secrets Manager, HashiCorp Vault
# 6. The .env file should be in .gitignore (already configured)